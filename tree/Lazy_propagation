#include <bits/stdc++.h>
using namespace std;

class ST {
    vector<int> seg, lazy;

public:
    ST(int n) {
        seg.resize(4 * n);
        lazy.resize(4 * n);
    }

    // build the segment tree
    void build(int ind, int low, int high, vector<int>& arr) {

        if (low == high) {
            seg[ind] = arr[low];
            return;
        }

        int mid = (low + high) / 2;

        build(2 * ind + 1, low, mid, arr);
        build(2 * ind + 2, mid + 1, high, arr);

        seg[ind] = seg[2 * ind + 1] + seg[2 * ind + 2];
    }

    // update the segment tree
    void update(int ind, int low, int high, int l, int r, int val) {

        // update of previous remaining update
        // it is update when traverse the segment tree
        //
        // If this node has some pending update from an earlier operation,
        // first apply that update to the current node.
        if (lazy[ind] != 0) {

            // seg[ind] stores the SUM of [low, high].
            // Number of elements in this range = high-low+1.
            // So if we add lazy[ind] to every element,
            // total sum increases by (high-low+1) * lazy[ind].
            seg[ind] += (high - low + 1) * lazy[ind];

            if (low != high) {
                // Child nodes will get this update later when we visit them.
                lazy[2 * ind + 1] += lazy[ind];
                lazy[2 * ind + 2] += lazy[ind];
            }

            // Current node's pending update has now been applied.
            lazy[ind] = 0;
        }

        // no overlap we do not do anything
        // low high l r OR l r low high
        if (high < l || r < low)
            return;

        // complete overlap l low high r
        // update the node and lazy propagate down and return
        if (l <= low && high <= r) {

            // seg[ind] stores the sum of the complete [low, high] range.
            // We are adding val to every element in this range.
            //
            // Example:
            // [2,5] contains 4 elements.
            // If val = 10, sum increases by 4*10 = 40.
            seg[ind] += (high - low + 1) * val;

            if (low != high) {
                // Child nodes are not immediately updated.
                // We only store the pending update in lazy.
                lazy[2 * ind + 1] += val;
                lazy[2 * ind + 2] += val;
            }

            return;
        }

        // partial overlap
        int mid = (low + high) / 2;

        // Your original code had build() here.
        // But this is an UPDATE operation, so we must call update().
        update(2 * ind + 1, low, mid, l, r, val);
        update(2 * ind + 2, mid + 1, high, l, r, val);

        // After updating both children,
        // calculate the current node's sum again.
        seg[ind] = seg[2 * ind + 1] + seg[2 * ind + 2];
    }

    // query method
    int query(int ind, int low, int high, int l, int r) {

        // update of previous remaining update
        // it is update when traverse the segment tree
        //
        // Before querying this node, first apply any pending update.
        if (lazy[ind] != 0) {

            // Apply pending update to the current segment.
            seg[ind] += (high - low + 1) * lazy[ind];

            if (low != high) {
                // Pass the pending update to children.
                lazy[2 * ind + 1] += lazy[ind];
                lazy[2 * ind + 2] += lazy[ind];
            }

            // Pending update is handled for this node.
            lazy[ind] = 0;
        }

        // no overlap
        if (high < l || r < low)
            return 0;

        // complete overlap
        if (l <= low && high <= r)
            return seg[ind];

        // partial overlap
        int mid = (low + high) / 2;

        // Your original code had build() here.
        // But this is a QUERY operation, so we must call query().
        int left = query(2 * ind + 1, low, mid, l, r);
        int right = query(2 * ind + 2, mid + 1, high, l, r);

        return left + right;
    }
};

int main() {

    int n;
    cin >> n;

    vector<int> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    ST st(n);

    st.build(0, 0, n - 1, a);

    int q;
    cin >> q;

    while (q--) {

        int type;
        cin >> type;

        if (type == 1) {

            int l, r;
            cin >> l >> r;

            // query() belongs to ST object, so use st.query()
            cout << st.query(0, 0, n - 1, l, r) << endl;
        }
        else {

            int l, r, val;
            cin >> l >> r >> val;

            // update() belongs to ST object, so use st.update()
            st.update(0, 0, n - 1, l, r, val);
        }
    }

    return 0;
}
